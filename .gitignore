# Build outputs
/build/
/build-*/
/recompiler/build/
*.exe
*.dll
*.o
*.obj
*.a
*.lib
*.pdb
*.ilk

# Recompiler output is a build artifact (CLAUDE.md rule 4): regenerate, don't commit
# ANCHORED. Unanchored, this also swallowed
# recompiler/lib/rabbitizer/**/generated/*.h -- vendored headers that
# upstream tracks and the recompiler cannot compile without.
/generated/

# Fetched dependencies
# NOT a fetched dependency: upstream tracks runtime/third_party/stb_image.h
# and psx_window_icon.cpp includes it, so ignoring it left a fresh clone
# unable to compile. Rule removed deliberately.
_deps/

# Local runtime state
/saves/
/*.pst
/*.thumb
/*.mcd
# anchored: runtime/tests/*.mcd are fixtures upstream tracks
menu_settings.ini
keybinds.ini
input.ini
mods/state.toml

# Editor / OS
/.vscode/
# anchored: vendored libs ship their own .vscode upstream
.idea/
*.swp
Thumbs.db
.DS_Store

# Artifacts a setup-host run drops into this tree. disc.cfg is the worst of
# them: it records the LOCAL path to the player's disc image.
disc.cfg
bios.cfg
psx_last_run_report.json
psx_crash.txt
psx_freeze_heartbeat.json
psx_screenshot.bmp
__pycache__/
/toolchain
